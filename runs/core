#!/usr/bin/env bash

set -euo pipefail

case "$OS" in
    fedora)
        sudo dnf install -y \
            gcc-c++ gcc clang clang-tools-extra ninja-build \
            git curl wget moreutils make cmake unzip \
            desktop-file-utils parallel tmux jq \
            stow btop unison
        ;;
    ubuntu)
        sudo apt-get install -y \
            gcc-c++ g++ clangd clang-format clang-tidy ninja-build \
            git curl wget moreutils make cmake unzip \
            desktop-file-utils parallel tmux jq \
            stow btop unison
        ;;
esac
