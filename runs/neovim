#!/usr/bin/env bash

set -euo pipefail

nvim_dir="/usr/local/opt/nvim"
asset="nvim-linux-x86_64.tar.gz"
plugin_dir="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/pack/local/start"

# Nightly is a rolling release: NVIM_UPDATE=1 reinstalls it.
if ! command -v nvim &>/dev/null || [[ "${NVIM_UPDATE:-0}" == "1" ]]; then
    cd "${TMPDIR}"
    curl -fsSL -O "https://github.com/neovim/neovim/releases/download/nightly/${asset}"
    tar -xf "${asset}"

    sudo mkdir -p /usr/local/opt
    sudo rm -rf "$nvim_dir"
    sudo mv "${asset%.tar.gz}" "$nvim_dir"
    sudo ln -sf "$nvim_dir/bin/nvim" /usr/local/bin/nvim

    nvim --version | head -1
fi

if [[ ! -d "$plugin_dir/quickfill.nvim" ]]; then
    if [[ ! -d "$CODEDIR/quickfill.nvim" ]]; then
        git clone https://github.com/davkk/quickfill.nvim "$CODEDIR/quickfill.nvim"
    fi
    mkdir -p "$plugin_dir"
    ln -sfn "$CODEDIR/quickfill.nvim" "$plugin_dir/quickfill.nvim"
fi
