#!/usr/bin/env bash
# nvimctl - drive named agent workers in terminals inside the host nvim.
set -u

ROOT=${XDG_RUNTIME_DIR:-/tmp}/nvimctl
TIMEOUT=${NVIMCTL_TIMEOUT:-110}
MAX=${NVIMCTL_MAX:-2}
LAYOUT=${NVIMCTL_LAYOUT:-split}

self=$0
while [ -L "$self" ]; do
    d=$(dirname "$self")
    t=$(readlink "$self")
    case $t in /*) self=$t ;; *) self=$d/$t ;; esac
done
SELF_DIR=$(cd -P "$(dirname "$self")" && pwd)
MODULE=$SELF_DIR/../lib/nvimctl/nvimctl.lua
[ -f "$MODULE" ] || { echo "nvimctl: module not found: $MODULE" >&2; exit 1; }

if base64 -w0 </dev/null >/dev/null 2>&1; then B64='base64 -w0'; else B64='base64 -b 0'; fi

die() { echo "nvimctl: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
usage: nvimctl COMMAND [ARGS]

  ask NAME @FILE [-- CMD...]   send a task, wait, print the outcome
  input NAME TEXT...           send raw bytes to a running worker
  stop NAME                    kill a finished or dead worker
  done                         worker side: end this worker's turn

BUF is always a worker name. Tasks are files; no shell quoting.
EOF
}

RPC='(function() local a = vim.tbl_map(vim.base64.decode, _A) local p = table.remove(a, 1) local f, err = loadfile(p) if not f then return "nvimctl: " .. tostring(err) end return f().cli(a) end)()'

check() { case ${1:-} in nvimctl:*) die "${1#nvimctl: }" ;; esac; }

valid_name() {
    case ${1:-} in "" | *[!A-Za-z0-9_.-]*) die "bad worker name '${1:-}' (letters, digits, _ . -)" ;; esac
}

cmd=${1:-}
case $cmd in "" | -h | --help | help) usage; exit 0 ;; esac
shift

# Worker side: markers only, no nvim connection.
if [ "$cmd" = done ]; then
    name=${NVIMCTL_NAME:-}
    [ -n "$name" ] || die "done runs inside a worker (NVIMCTL_NAME is unset)"
    [ -n "${NVIM:-}" ] || die "done runs inside a worker (NVIM is unset)"
    d=$ROOT/$(basename "$NVIM")
    mkdir -p "$d" || die "cannot write to $d"
    : > "$d/$name.done" || die "cannot write to $d"
    rm -f "$d/$name.busy"
    exit 0
fi

rpc_on() {
    local sock=$1; shift
    local args="'$(printf %s "$MODULE" | $B64)'" arg
    for arg in "$@"; do args+=",'$(printf %s "$arg" | $B64)'"; done
    nvim --headless --server "$sock" --remote-expr "luaeval('$RPC', [$args])" </dev/null
}

host_call() {
    local out
    out=$(rpc "$@") || die "cannot reach nvim at $SOCK"
    check "$out"
    printf '%s\n' "$out"
}

try() {
    local out
    out=$(rpc "$@" 2>/dev/null) || return 0
    case $out in nvimctl:*) return 0 ;; esac
    printf '%s\n' "$out"
}

rpc() { rpc_on "$SOCK" "$@"; }

nvim_live() { nvim --headless --server "$1" --remote-expr '1' </dev/null >/dev/null 2>&1; }

sockets() {
    local s
    for s in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0 "${TMPDIR:-/tmp}"/nvim.*/*/nvim.*.0 "${TMPDIR:-/tmp}"/nvim.*.0; do
        [ -S "$s" ] && echo "$s"
    done
}

# Caller identity: pid chain and non-shell command names, from ps on both
# Linux and macOS. Passed to nvim so spawn can find the caller's window.
pids= exes=
ancestry() {
    local p=$$ q e i
    pids=$$
    for ((i = 0; i < 64; i++)); do
        q=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d '[:space:]')
        [ -n "$q" ] || break
        p=$q
        pids="$pids $p"
        [ "$p" -le 1 ] && break
    done
    for q in $pids; do
        e=$(ps -o comm= -p "$q" 2>/dev/null | sed 's/^[[:space:]]*//')
        [ -n "$e" ] || continue
        case ${e##*/} in
            bash|sh|dash|zsh|fish|ksh|ash|nvim|vim|systemd|konsole|kitty|alacritty|wezterm|tmux|screen|ssh|sudo|env) ;;
            *) case " $exes " in *" $e "*) ;; *) exes="$exes $e" ;; esac ;;
        esac
    done
}

scan_sockets() {
    local s out
    while read -r s; do
        out=$(rpc_on "$s" anchor_for "$pids" "$exes" 2>/dev/null) || continue
        case $out in "" | 0) ;; *) echo "$s"; return 0 ;; esac
    done < <(sockets)
    return 1
}

ancestry
SOCK=${NVIM:-}
notes= guards=
if [ -n "$SOCK" ]; then
    if [ ! -S "$SOCK" ] || ! nvim_live "$SOCK"; then
        notes+="NVIM='$SOCK' is not a live socket"$'\n'
        SOCK=
    fi
fi
if [ -z "$SOCK" ]; then
    SOCK=$(scan_sockets) || SOCK=
    if [ -n "$SOCK" ]; then
        [ -n "${NVIM:-}" ] && notes+="using the instance that hosts the caller's terminal: $SOCK"$'\n'
    else
        notes+="no live nvim hosts this terminal; run nvimctl inside nvim or export NVIM=<socket>"$'\n'
    fi
fi
if [ -n "$SOCK" ]; then
    while read -r s; do
        [ "$s" = "$SOCK" ] && continue
        [ "$(rpc_on "$s" has_caller_terminal "$pids" 2>/dev/null)" = 1 ] || continue
        guards+="the caller's terminal is in $s but nvimctl is driving $SOCK; export NVIM=$s"$'\n'
    done < <(sockets)
fi
[ -z "$notes$guards" ] || die "$(printf '%s' "$notes$guards" | sed '/^$/d')"
[ -n "$SOCK" ] || die "no nvim instance; run nvimctl inside nvim or export NVIM=<socket>"

D=$ROOT/$(basename "$SOCK")
mkdir -p "$D" || die "cannot write to $D"

screen() {
    local s
    s=$(try read "$1") || return 0
    case $s in "" | nvimctl:*) return 0 ;; esac
    printf '%s\n' "$s" | tail -n "$2"
}

wait_ready() {
    local name=$1 r s i ready=0 stable=0 previous='' content last
    for ((i = 0; i < 20; i++)); do
        r=$(try ready "$name")
        case $r in
            1) ready=1; break ;;
            '?')
                for _ in 1 2 3 4; do
                    sleep 0.5
                    [ -n "$(screen "$name" 1)" ] && { ready=1; break; }
                done
                break
                ;;
        esac
        sleep 0.5
    done
    [ $ready -eq 1 ] || { echo "nvimctl: worker '$name' is not ready after 10s; stop it and ask again with -- CMD." >&2; return 1; }
    for ((i = 0; i < 60; i++)); do
        s=$(try read "$name")
        content=$(printf '%s' "$s" | tr -d '[:space:]')
        last=$(printf '%s\n' "$s" | sed '/^[[:space:]]*$/d' | tail -n 1)
        case $last in *'$ ' | *'% ' | *'# ' | *'❯ ') content= ;; esac
        if [ -n "$content" ] && [ "$s" = "$previous" ]; then
            stable=$((stable + 1))
            [ $stable -ge 3 ] && return 0
        else
            stable=0
        fi
        previous=$s
        sleep 0.3
    done
    echo "nvimctl: worker '$name' screen never settled; stop it and ask again with -- CMD." >&2
    return 1
}

send_chunks() {
    local name=$1 payload=$2 chunk out
    while [ -n "$payload" ]; do
        chunk=${payload:0:160}
        payload=${payload:160}
        out=$(host_call send "$name" "$chunk") || return 1
        sleep 0.03
    done
    return 0
}

wait_for() {
    local name=$1 secs=$2 i code scr
    if [ ! -f "$D/$name.busy" ] && [ ! -f "$D/$name.done" ] && [ ! -f "$D/$name.exit" ]; then
        [ "$(try alive "$name")" = 1 ] && { echo idle; return 0; }
        echo "exit 1"
        screen "$name" 20
        return 1
    fi
    for ((i = 0; i <= secs; i += 2)); do
        if [ -f "$D/$name.done" ]; then
            rm -f "$D/$name.done" "$D/$name.busy"
            echo done
            screen "$name" 40
            return 0
        fi
        if [ -f "$D/$name.exit" ] || [ "$(try alive "$name")" != 1 ]; then
            sleep 0.2
            code=$(cat "$D/$name.exit" 2>/dev/null)
            rm -f "$D/$name.exit" "$D/$name.busy"
            echo "exit ${code:-1}"
            screen "$name" 20
            return 1
        fi
        sleep 2
    done
    echo timeout
    screen "$name" 20
    return 1
}

spawn_worker() {
    local name=$1 out
    shift
    out=$(host_call spawn "$PWD" "$pids" "$exes" "$name" "$LAYOUT" "$MAX" "$@") || exit 1
    case $out in "" | *[!0-9]*) die "spawn failed: $out" ;; esac
    printf '%s\n' "$out"
}

case $cmd in
ask)
    valid_name "${1:-}"
    name=$1
    shift
    args=() cmdv=()
    while [ $# -gt 0 ]; do
        if [ "$1" = -- ]; then shift; cmdv=("$@"); break; fi
        args+=("$1")
        shift
    done
    [ ${#args[@]} -gt 0 ] || die "usage: nvimctl ask NAME @FILE|TEXT... [-- CMD...]"
    if [ ${#args[@]} -eq 1 ] && [ "${args[0]:0:1}" = @ ]; then
        f=${args[0]:1}
        [ -f "$f" ] && [ -r "$f" ] || die "task file not readable: $f"
        text=$(cat "$f") || die "cannot read task file: $f"
    else
        text="${args[*]}"
    fi
    [ -n "$text" ] || die "empty task"
    case $text in '!'*) die "task must not start with '!'" ;; esac
    if [ "$(try alive "$name")" != 1 ]; then
        [ ${#cmdv[@]} -gt 0 ] || die "worker '$name' is not running; add -- CMD to start it"
        spawn_worker "$name" "${cmdv[@]}" >/dev/null
    fi
    [ -f "$D/$name.busy" ] && die "worker '$name' is busy; run: nvimctl wait $name"
    [ -f "$D/$name.done" ] && die "worker '$name' has an uncollected result; run: nvimctl wait $name"
    rm -f "$D/$name.exit"
    : > "$D/$name.busy" || die "cannot write to $D"
    fail() { rm -f "$D/$name.busy"; exit 1; }
    wait_ready "$name" || fail
    send_chunks "$name" "$text" || fail
    step="
You are a worker: do this task, ask nothing, run no memo commands.

When this is finished, end with a short report of what you did, then run exactly this in your shell and stop:
  nvimctl done
"
    send_chunks "$name" "$step" || fail
    host_call send "$name" $'\r' >/dev/null || fail
    wait_for "$name" "$TIMEOUT"
    ;;
wait)
    valid_name "${1:-}"
    name=$1
    secs=${2:-$TIMEOUT}
    case $secs in "" | *[!0-9]*) die "bad seconds '$secs'" ;; esac
    wait_for "$name" "$secs"
    ;;
stop)
    valid_name "${1:-}"
    name=$1
    host_call stop "$name" >/dev/null || exit 1
    rm -f "$D/$name".busy "$D/$name".done "$D/$name".exit
    printf 'stopped\n'
    ;;
input|steer)
    valid_name "${1:-}"
    name=$1
    shift
    [ $# -gt 0 ] || die "usage: nvimctl input NAME TEXT..."
    text=$(printf '%b.' "$*")
    host_call send "$name" "${text%.}" >/dev/null || exit 1
    ;;
read)
    valid_name "${1:-}"
    name=$1
    host_call read "$name"
    ;;
*)
    die "unknown command '$cmd' (see nvimctl --help)"
    ;;
esac
